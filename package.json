{
  "name": "reports-system",
  "version": "2.0.0",
  "description": "نظام إدارة التقارير الميدانية ومتابعتها وتقييم المستخدمين",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "cap:init": "npx @capacitor/cli init \"نظام التقارير\" \"com.company.reportssystem\" --web-dir public",
